# Copy to .env.local only when overriding the local defaults.
PORT=35174
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:35174
SEED_DEMO=true

# Use a MongoDB Atlas URI and a database reserved for ShopEase.
MONGO_URI=
MONGO_DB_NAME=shopease
JWT_SECRET=

# Optional for local development. SMTP sends real reset email when configured.
SMTP_URL=
MAIL_FROM=
GOOGLE_MAPS_EMBED_KEY=
GOOGLE_MAPS_DEMO_KEY=
